{
  "name": "pyra",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @pyra/web dev",
    "dev:worker": "pnpm --filter @pyra/worker dev",
    "build": "pnpm --filter @pyra/web build && pnpm --filter @pyra/worker build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @pyra/db db:generate",
    "db:migrate": "pnpm --filter @pyra/db db:migrate",
    "db:push": "pnpm --filter @pyra/db db:push",
    "prepare": "husky"
  },
  "devDependencies": {
    "@neon/config": "^1.7.3",
    "@neon/env": "^1.4.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.5.4"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.21",
      "smol-toml": ">=1.7.1",
      "js-yaml": ">=4.3.2"
    }
  }
}
